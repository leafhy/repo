#!/bin/sh

cat <<EOF

################################

NOTE: To start netatalk at boot
      add this to '/etc/rc.d/setup.boot'.

# ------ BEGIN ------ #

cnid_metad
afpd

# ------- END ------- #

NOTE: 'cnid_metad' needs to
      start before 'afpd'.

NOTE: To access an netatalk share
      from OSX/MacOS use Finder's
     'Go' menu -> Connect to Server.

     -> afp://user@ipaddress

NOTE: If avahi & dbus are installed
      the netatalk share will automatically
      appear in Finder's sidebar.

################################

EOF
