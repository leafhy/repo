#!/bin/sh -e

cat <<EOF

################################

NOTE: To use rbw with caddy add
      the required http/s entry
      to '/etc/caddy/Caddyfile'.

# ------{ BEGIN }------ #
# rbw Unofficial Bitwarden CLI
vaultwarden.local:2014 {
	tls internal
	reverse_proxy 127.0.0.1:8000
}

# rbw Unofficial Bitwarden CLI
http://vaultwarden.local:2018 {
	reverse_proxy 127.0.0.1:8000
}
# -------{ END }------- #

NOTE: Add caddy's root.crt to the
      systems certificate store.

-> cat root.crt | tee -a /etc/ssl/cert.pem
or
-> cat /etc/ssl/cert.pem root.crt | tee /etc/ssl/certupd.pem

NOTE: Add the certupd.crt export to '.profile'.

-> export SSL_CERT_FILE="/etc/ssl/certupd.pem"

NOTE: caddy's certificates can be added
      to '.profile' in lieu of using '/etc/ssl'.

-> export SSL_CERT_FILE="/var/lib/caddy/.local/share/caddy/certificates/local/vaultwarden.local/vaultwarden.local.crt"
-> export SSL_CERT_FILE="/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt"

NOTE: Verify 'http/s' is working.

-> curl http://192.XXX.X.X:2018
-> curl http://vaultwarden.local:2018
-> curl https://192.XXX.X.X:2014
-> curl https://vaultwarden.local:2014

NOTE: This pinentry error may occur after running 'rbw purge', 'rbw stop-agent' necessitating a 'reboot'.
      "rbw list: failed to read password from pinentry: failed to parse pinentry output ("S ERROR curses.open_tty_for_read 83918849 \nERR 83918849 Permission denied <Pinentry>\n\0\0\0\0\0\0")"

NOTE: This error message can be resolved by updating rbw and or running 'rbw purge'.
      "WARN: failed to decrypt ...: failed to decrypt: failed to decrypt encrypted secret: invalid mac"

NOTE: Using the '.config/rbw/config.json' option "client_cert_path" causes the following error.
      "rbw login: failed to log in to bitwarden instance: failed to create reqwest client: builder error: unexpected error: private key or certificate not found"

################################

EOF
