#!/bin/sh

if [ -L /var/service/nanoklogd ]; then
    sv down nanoklogd
    unlink /var/service/nanoklogd
fi

if [ -L /var/service/socklog-unix ]; then
    sv down socklog-unix
    unlink /var/service/socklog-unix
fi

delgroup socklog

rm -rf \
    "/etc/sv/nanoklogd" \
    "/etc/sv/socklog-unix" \
    "/var/log/socklog" \
    "/run/runit/supervise.nanoklogd" \
    "/run/runit/supervise.socklog-unix" \
    "/run/runit/supervise.socklog-unix-log"

