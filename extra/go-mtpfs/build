#!/bin/sh -e

if [ "$(id -u)" != 0 ]; then
    printf '%s' '
#####################################
#                                   #
# [ ! ] NEED TO BUILD AS ROOT [ ! ] #
#                                   #
#      ssu -p kiss b go-mtpfs       #
#                                   #
#####################################
'
    exit 1
fi

go build ./

install -Dm755 go-mtpfs "$1/usr/bin/go-mtpfs"
