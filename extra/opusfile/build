#!/bin/sh -e

# --disable-examples appears to be broken.
sed -i 's/noinst_PROGRAMS =/#noinst_PROGRAMS =/' Makefile

./configure \
    --prefix=/usr \
    --enable-shared \
    --enable-static \
    --disable-doc \
    --disable-examples \
    --disable-http \
    --disable-dependency-tracking

make
make install

# Remove documentation.
rm -rf "$1/usr/share"
