#!/bin/sh -e

# Disable HTML documentation.
sed 's/html man/man/' doc/Makefile.in > _
mv -f _ doc/Makefile.in

{
    ./configure \
        ac_cv_lib_ncurses_initscr=no \
        ac_cv_lib_curses_initscr=no \
        --prefix=/usr \
        --enable-shared \
        --disable-static \
        --disable-gtktest

    make
    make install
    make clean
}

{
    ./configure \
        ac_cv_lib_ncurses_initscr=no \
        ac_cv_lib_curses_initscr=no \
        --prefix=/usr \
        --disable-shared \
        --enable-static \
        --disable-gtktest

    make LDFLAGS="$LDFLAGS -all-static"
    make install
}

