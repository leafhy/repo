#!/bin/sh -e

sed -i "29s|.*|chmod u+s \"\${DESTDIR}\${bindir}/fusermount3\"|" \
    util/install_helper.sh

export DESTDIR="$1"

meson \
    --prefix=/usr \
    -Dsbindir=bin \
    -Dudevrulesdir=/usr/lib/udev \
    -Dexamples=false \
    -Duseroot=false \
    -Ddefault_library=both \
    . output

ninja -C output
ninja -C output install

ln -sf fusermount3 "$1/usr/bin/fusermount"

# Remove the unused.
rm -rf \
    "$1/usr/lib/udev" \
    "$1/etc/init.d"
