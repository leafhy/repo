#!/bin/sh -e

cat <<EOF

###############################################
#                                             #
#    [ ! ]  WARNING WARNING WARNING  [ ! ]    #
#                                             #
#             REMOVING VAULTWARDEN            #
#                     WILL                    #
#                 REMOVE VAULT                #
#                                             #
###############################################

EOF

printf '%s\n' "Do you wish to remove Vaultwarden?"
printf '%s' "yes/no: "
read -r ans

if [ "$ans" = no ]; then
    printf '%s\n' "Aborted Vaultwarden removal."
    exit 1

elif [ "$ans" = yes ]; then
    if [ -L /var/service/vaultwarden ]; then
        sv down vaultwarden
        unlink "/var/service/vaultwarden"
    fi

    deluser --remove-home vaultwarden

    rm -f \
        "/etc/vaultwarden.conf" \
        "/var/log/vaultwarden.log"

    rm -rf \
        "/etc/sv/vaultwarden" \
        "/run/runit/supervise.vaultwarden"

fi
